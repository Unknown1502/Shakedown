# Copy to .env (git-ignored) and fill in real values. Never commit real values; never paste them into chat.

# --- Shakedown generation (Nebius Token Factory + Tavily) -----------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TAVILY_API_KEY=

# --- Read-only Splunk preflight (optional; see docs/SPLUNK_PREFLIGHT.md) --------------------------------------------
# The management API, normally port 8089. https is required except for a loopback test instance.
SPLUNK_BASE_URL=https://splunk.example.internal:8089
# Preferred: an authentication token for a search-only role. Or use SPLUNK_USERNAME and SPLUNK_PASSWORD instead.
SPLUNK_TOKEN=
# SPLUNK_USERNAME=
# SPLUNK_PASSWORD=
# The only indexes a preflight may search. Comma separated. Wildcards are refused.
SPLUNK_ALLOWED_INDEXES=win_sysmon
# TLS is verified by default. Point at your CA bundle if Splunk uses a private CA. Turning verification off is recorded in the packet.
# SPLUNK_CA_BUNDLE=/path/to/ca.pem
# SPLUNK_VERIFY_TLS=true
# Limits (defaults shown)
# SPLUNK_MAX_RESULTS=5            # matching events shown in the packet
# SPLUNK_MAX_TIME_RANGE_HOURS=168 # widest window a preflight may search
# SPLUNK_SEARCH_TIMEOUT_S=120     # per search; a search that overruns is cancelled and deleted
# SPLUNK_ALLOW_PRIVILEGED=false   # accounts with admin-class capabilities are refused unless you set this to true
